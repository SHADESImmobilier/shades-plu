# ~/.paybyphone-handi/handi.env — paramètres du ticket quotidien (pas de secret ici)

# Noms des entrées du fichier ~/.config/paybybot3.yml à déclarer chaque jour,
# séparés par des espaces. Ne mets QUE les véhicules réellement stationnés en voirie.
CONFIGS="voiture1"

# ratePolicyId du tarif HANDI / CMI, obtenu avec :
#   ~/.paybyphone-handi/venv/bin/paybybot3 rate-options voiture1 --location 75001
RATE=""

# Arrondissement (locationId). Le tarif Handi est "toutes zones" : un seul suffit.
LOCATION="75001"

# Durée du ticket
DURATION="24"
UNIT="Hours"

# Notification de secours si paybybot3 lui-même n'a pas pu prévenir
# (par exemple pas d'Internet). Laisse vide pour désactiver.
# Format Apprise, ex. "mailtos://user:motdepasseapp@gmail.com?to=user@gmail.com"
FALLBACK_NOTIFY=""
