# ============================================================================
# MitzvaNOW — variables d'environnement (exemple). NE PAS committer de vraies clés.
# ============================================================================
# Copiez ce fichier et renseignez les valeurs dans les bons endroits :
#   - Valeurs CLIENT  -> mobile/app.json > "extra" (ou variables EXPO_PUBLIC_*)
#   - Secrets SERVEUR -> Supabase : `supabase secrets set NOM=valeur`
# Les secrets serveur ne doivent JAMAIS être embarqués dans l'app mobile.

# ---- CLIENT (mobile) — valeurs publiques, embarquées dans l'app ----
# URL du projet Supabase, ex: https://xxxx.supabase.co
SUPABASE_URL=
# Clé "anon" publique Supabase (protégée par les RLS)
SUPABASE_ANON_KEY=
# Clé publiable Stripe (pk_live_… en prod, pk_test_… en dev)
STRIPE_PUBLISHABLE_KEY=

# ---- SERVEUR (Supabase Edge Functions) — SECRETS, jamais côté client ----
# Injectées automatiquement par Supabase : SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY (ne pas les redéfinir).
# Clé API Anthropic pour la vision anti-fraude (submit_session). REQUIS.
ANTHROPIC_API_KEY=
# Service de reconnaissance faciale pour le dédoublonnage "1x/jour" du posé. Optionnel.
# S'il est absent, les mises partent en revue manuelle (jamais de crédit auto).
FACE_API_URL=
FACE_API_KEY=
# Clé secrète Stripe (sk_live_… / sk_test_…) pour create_donation. REQUIS pour la tsedaka.
STRIPE_SECRET_KEY=
# (Optionnel) Secret de webhook Stripe si vous branchez les webhooks de paiement.
STRIPE_WEBHOOK_SECRET=
