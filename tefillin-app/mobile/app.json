{
  "expo": {
    "name": "MitzvaNOW",
    "slug": "mitzvanow",
    "scheme": "mitzvanow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shades.mitzvanow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pour trouver le poseur de tefillin le plus proche et valider la mise.",
        "NSCameraUsageDescription": "Pour prendre la photo de la mise (poseur + posé avec les tefillin) qui valide le Mivtza."
      }
    },
    "android": {
      "package": "com.shades.mitzvanow",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-camera",
      "expo-secure-store",
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.shades.mitzvanow",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://YOUR-PROJECT.supabase.co",
      "supabaseAnonKey": "YOUR-ANON-KEY",
      "stripePublishableKey": "pk_test_YOUR-KEY"
    }
  }
}
